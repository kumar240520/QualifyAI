# QualifyAI Environment Configuration Guide
# Single Vercel Monorepo Deployment + Local Development

# ==============================================================================
# 1. CLIENT-SAFE ENVIRONMENT VARIABLES (Exposed in browser bundle)
# ==============================================================================
# In production on Vercel: set VITE_API_URL=/api (or leave unset to default to /api)
# In local development: http://localhost:5000/api (or /api via Vite proxy)
VITE_API_URL=/api

# Supabase Public Configuration (Safe for client bundle)
VITE_SUPABASE_URL=https://gyyvjswwdhegfqxizdvl.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================================================
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (NEVER prefix with VITE_)
# ==============================================================================
# Server Runtime
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# Supabase Database & Auth (Server-side)
SUPABASE_URL=https://gyyvjswwdhegfqxizdvl.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Highly recommended for security-definer RPCs & server operations:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini AI Reasoning & Rubrics
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# CosyVoice TTS (Optional / Server-only)
TTS_PROVIDER=cosyvoice
COSYVOICE_API_URL=http://localhost:50000
COSYVOICE_API_KEY=
COSYVOICE_MODEL=Fun-CosyVoice-3
COSYVOICE_VOICE_ID=qualifyai_interviewer_01
COSYVOICE_SAMPLE_RATE=24000
