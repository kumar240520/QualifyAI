# QualifyAI Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase Authentication & Database
SUPABASE_URL=https://gyyvjswwdhegfqxizdvl.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=server_only_never_prefix_with_VITE_

# Google Gemini AI Reasoning & Rubrics
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# CosyVoice TTS (server only; configure a reachable CosyVoice-compatible service URL)
TTS_PROVIDER=cosyvoice
COSYVOICE_API_URL=http://localhost:50000
COSYVOICE_API_KEY=
COSYVOICE_MODEL=Fun-CosyVoice-3
COSYVOICE_VOICE_ID=qualifyai_interviewer_01
COSYVOICE_SAMPLE_RATE=24000

# Client Environment
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://gyyvjswwdhegfqxizdvl.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
