{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "outputDirectory": "dist",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/app.js",
      "bindings": [
        {
          "type": "service",
          "service": "client",
          "format": "url",
          "env": "CLIENT_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
